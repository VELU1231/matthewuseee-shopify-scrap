{% comment %}
  ┌─────────────────────────────────────────────────────────────┐
  │  sections/custom-signature-scent.liquid                     │
  │  "THE SIGNATURE SCENT OF QUIET CONFIDENCE"                  │
  │                                                             │
  │  Full-width dark section with:                              │
  │  - Eyebrow label                                            │
  │  - H2 heading                                               │
  │  - Body description paragraph                               │
  │  - Fragrance notes grid (blocks)                            │
  │  - Dual CTA buttons                                         │
  │                                                             │
  │  Docs:                                                      │
  │  shopify.dev/docs/storefronts/themes/architecture/sections  │
  └─────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign note_blocks = section.blocks | where: 'type', 'note'
-%}

<section
  id="custom-signature-scent-{{ section.id }}"
  class="signature-scent"
  style="background-color: {{ bg_color }}; color: {{ text_color }};"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="signature-scent__inner page-width">

    {%- if section.settings.eyebrow != blank -%}
      <p class="signature-scent__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="signature-scent__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="signature-scent__description">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- if note_blocks.size > 0 -%}
      <ul class="signature-scent__notes" aria-label="Fragrance notes" role="list">
        {%- for block in note_blocks -%}
          <li class="signature-scent__note" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <span class="signature-scent__note-label">{{ block.settings.label | escape }}</span>
            {%- endif -%}
            {%- if block.settings.detail != blank -%}
              <span class="signature-scent__note-detail">{{ block.settings.detail | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.btn_primary_label != blank or section.settings.btn_secondary_label != blank -%}
      <div class="signature-scent__ctas">
        {%- if section.settings.btn_primary_label != blank -%}
          <a
            href="{{ section.settings.btn_primary_url | default: '#' }}"
            class="signature-scent__btn signature-scent__btn--primary btn"
          >
            {{- section.settings.btn_primary_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.btn_secondary_label != blank -%}
          <a
            href="{{ section.settings.btn_secondary_url | default: '#' }}"
            class="signature-scent__btn signature-scent__btn--secondary btn btn--secondary"
          >
            {{- section.settings.btn_secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  #custom-signature-scent-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    text-align: {{ section.settings.text_alignment }};
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__inner {
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.65;
    margin-bottom: 1rem;
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__heading {
    font-size: clamp(2.25rem, 4.8vw, 3rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
    color: {{ text_color }};
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__description {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.85;
    margin-bottom: 2rem;
    max-width: 640px;
    {% if section.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  /* Fragrance notes grid */
  #custom-signature-scent-{{ section.id }} .signature-scent__notes {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    {% if section.settings.text_alignment == 'center' %}
      justify-content: center;
    {% endif %}
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__note {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    min-width: 120px;
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__note-label {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__note-detail {
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* Dark bg — override note border for light bg */
  {%- if bg_color == '#ffffff' or bg_color == 'white' -%}
  #custom-signature-scent-{{ section.id }} .signature-scent__note {
    border-color: rgba(0, 0, 0, 0.15);
  }
  {%- endif -%}

  /* CTAs */
  #custom-signature-scent-{{ section.id }} .signature-scent__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    {% if section.settings.text_alignment == 'center' %}
      justify-content: center;
    {% endif %}
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 5px;
    transition: background-color 0.2s ease, color 0.2s ease;
    cursor: pointer;
    border: 2px solid transparent;
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__btn--primary {
    background-color: {{ section.settings.btn_primary_bg }};
    color: {{ section.settings.btn_primary_text }};
    border-color: {{ section.settings.btn_primary_bg }};
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__btn--secondary {
    background-color: transparent;
    color: {{ text_color }};
    border-color: {{ text_color }};
  }

  #custom-signature-scent-{{ section.id }} .signature-scent__btn--secondary:hover {
    background-color: {{ text_color }};
    color: {{ bg_color }};
  }

  @media (max-width: 749px) {
    #custom-signature-scent-{{ section.id }} .signature-scent__heading {
      font-size: 1.75rem;
    }

    #custom-signature-scent-{{ section.id }} .signature-scent__ctas {
      flex-direction: column;
      align-items: {% if section.settings.text_alignment == 'center' %}center{% else %}flex-start{% endif %};
    }

    #custom-signature-scent-{{ section.id }} .signature-scent__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Signature Scent",
  "tag": "section",
  "class": "section-signature-scent",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Flagship Fragrance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE SIGNATURE SCENT OF QUIET CONFIDENCE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "GENTLEMAN is an Extrait de Parfum crafted for the man who commands attention without demanding it. A blend of woods, musk, and refined citrus — made to last all day."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary button label",
      "default": "SHOP GENTLEMAN"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Primary button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_primary_text",
      "label": "Primary button text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary button label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary button URL"
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Fragrance Note",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Note type (e.g. Top Note)",
          "default": "Top Note"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Note detail (e.g. Bergamot)",
          "default": "Bergamot"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Signature Scent",
      "blocks": [
        { "type": "note", "settings": { "label": "Top Note", "detail": "Bergamot & Citrus" } },
        { "type": "note", "settings": { "label": "Heart Note", "detail": "Cedar & Vetiver" } },
        { "type": "note", "settings": { "label": "Base Note", "detail": "Musk & Sandalwood" } }
      ]
    }
  ]
}
{% endschema %}
