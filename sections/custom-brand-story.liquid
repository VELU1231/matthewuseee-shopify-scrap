{% comment %}
  ┌─────────────────────────────────────────────────────────────┐
  │  sections/custom-brand-story.liquid                         │
  │  "LUXURY WITHIN REACH. CRAFTED FOR MEN."                   │
  │                                                             │
  │  Split 50/50 image + text layout (same pattern as           │
  │  custom-discovery-set) with:                                │
  │  - Image side (selectable: left / right)                    │
  │  - Eyebrow, H2, body paragraphs, single CTA                 │
  │  - Stacks to single column on mobile (image on top)         │
  │                                                             │
  │  Docs:                                                      │
  │  shopify.dev/docs/storefronts/themes/architecture/sections  │
  └─────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign image_side = section.settings.image_side | default: 'left'
  assign img = section.settings.image
-%}

<section
  id="custom-brand-story-{{ section.id }}"
  class="brand-story"
  aria-labelledby="brand-story-heading-{{ section.id }}"
>
  <div class="brand-story__inner page-width brand-story__inner--image-{{ image_side }}">

    {%- comment -%} Image column {%- endcomment -%}
    <div class="brand-story__media">
      {%- if img != blank -%}
        {{
          img
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            class: 'brand-story__image',
            alt: section.settings.heading | escape,
            widths: '600, 800, 1000, 1200'
        }}
      {%- else -%}
        <div class="brand-story__image-placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'brand-story__image' }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Text column {%- endcomment -%}
    <div class="brand-story__content">

      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="brand-story__heading" id="brand-story-heading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.body_text != blank -%}
        <div class="brand-story__body">{{ section.settings.body_text }}</div>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <a
          href="{{ section.settings.btn_url | default: '/pages/about' }}"
          class="brand-story__btn btn"
        >
          {{- section.settings.btn_label | escape -}}
        </a>
      {%- endif -%}

    </div>

  </div>
</section>

<style>
  #custom-brand-story-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }

  /* Split grid */
  #custom-brand-story-{{ section.id }} .brand-story__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
    min-height: {{ section.settings.min_height }}px;
  }

  /* Image on right: reverse column order */
  #custom-brand-story-{{ section.id }} .brand-story__inner--image-right {
    direction: rtl;
  }
  #custom-brand-story-{{ section.id }} .brand-story__inner--image-right > * {
    direction: ltr;
  }

  /* Media */
  #custom-brand-story-{{ section.id }} .brand-story__media {
    position: relative;
    overflow: hidden;
  }

  #custom-brand-story-{{ section.id }} .brand-story__image,
  #custom-brand-story-{{ section.id }} .brand-story__image-placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  #custom-brand-story-{{ section.id }} .brand-story__media:hover .brand-story__image {
    transform: scale(1.03);
  }

  /* Content */
  #custom-brand-story-{{ section.id }} .brand-story__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding: 4rem 5%;
  }

  #custom-brand-story-{{ section.id }} .brand-story__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0;
  }

  #custom-brand-story-{{ section.id }} .brand-story__heading {
    font-size: clamp(2.25rem, 4vw, 2.8rem);
    line-height: 1.1;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  #custom-brand-story-{{ section.id }} .brand-story__body {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.8;
  }

  #custom-brand-story-{{ section.id }} .brand-story__body p {
    margin: 0 0 1rem;
  }

  #custom-brand-story-{{ section.id }} .brand-story__body p:last-child {
    margin-bottom: 0;
  }

  #custom-brand-story-{{ section.id }} .brand-story__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 12px 24px;
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }};
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 5px;
    border: 2px solid {{ section.settings.btn_bg }};
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #custom-brand-story-{{ section.id }} .brand-story__btn:hover {
    background-color: transparent;
    color: {{ section.settings.btn_bg }};
  }

  /* Mobile: single column, image on top */
  @media (max-width: 749px) {
    #custom-brand-story-{{ section.id }} .brand-story__inner {
      grid-template-columns: 1fr;
      direction: ltr;
      min-height: unset;
    }

    #custom-brand-story-{{ section.id }} .brand-story__media {
      aspect-ratio: 4 / 3;
    }

    #custom-brand-story-{{ section.id }} .brand-story__content {
      padding: 2.5rem 5%;
      gap: 1.25rem;
    }

    #custom-brand-story-{{ section.id }} .brand-story__heading {
      font-size: 1.75rem;
    }

    #custom-brand-story-{{ section.id }} .brand-story__btn {
      align-self: stretch;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "class": "section-brand-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum section height",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LUXURY WITHIN REACH. CRAFTED FOR MEN."
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Mattheusse was born from one idea: every man deserves to smell extraordinary — without paying extraordinary prices.</p><p>We source the same fragrance compounds used in ₱10,000 designer bottles. We cut the middlemen, skip the celebrity endorsements, and pass the savings to you.</p><p>This is luxury within reach. This is Mattheusse.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "ABOUT THE BRAND"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL",
      "info": "e.g. /pages/about"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
