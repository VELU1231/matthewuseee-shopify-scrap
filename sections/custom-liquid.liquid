{%- liquid
  assign custom_padding_top = section.settings.padding_top
  assign custom_padding_bottom = section.settings.padding_bottom
  assign custom_padding_top_mobile = section.settings.mobile_padding_top
  assign custom_padding_bottom_mobile = section.settings.mobile_padding_bottom

  if custom_padding_top == blank
    assign custom_padding_top = section.settings['padding-block-start']
  endif
  if custom_padding_bottom == blank
    assign custom_padding_bottom = section.settings['padding-block-end']
  endif
  if custom_padding_top_mobile == blank
    assign custom_padding_top_mobile = custom_padding_top
  endif
  if custom_padding_bottom_mobile == blank
    assign custom_padding_bottom_mobile = custom_padding_bottom
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style {% if section.settings.color_scheme != blank %}color-{{ section.settings.color_scheme }}{% endif %}"
  style="padding-top: {{ custom_padding_top }}px; padding-bottom: {{ custom_padding_bottom }}px;"
>
  {{ section.settings.custom_liquid }}
</div>

<style>
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .section {
      padding-top: {{ custom_padding_top_mobile }}px;
      padding-bottom: {{ custom_padding_bottom_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "t:names.custom_liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:settings.custom_liquid",
      "info": "t:info.custom_liquid"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Legacy padding (compatibility)"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
