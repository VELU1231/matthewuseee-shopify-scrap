{% comment %}
  ┌─────────────────────────────────────────────────────────────┐
  │  sections/custom-final-cta.liquid                           │
  │  "FIND YOUR SIGNATURE SCENT"                                │
  │                                                             │
  │  Full-bleed closing CTA banner with:                        │
  │  - Background image with overlay OR solid color             │
  │  - H2 heading + subtitle text                               │
  │  - Dual CTA buttons (primary + secondary)                   │
  │  - Centered layout                                          │
  │                                                             │
  │  Docs:                                                      │
  │  shopify.dev/docs/storefronts/themes/architecture/sections  │
  └─────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign bg_img = section.settings.bg_image
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section
  id="custom-final-cta-{{ section.id }}"
  class="final-cta"
  aria-labelledby="final-cta-heading-{{ section.id }}"
>
  {%- comment -%} Background image layer {%- endcomment -%}
  {%- if bg_img != blank -%}
    <div class="final-cta__bg" aria-hidden="true">
      {{
        bg_img
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          class: 'final-cta__bg-img',
          alt: '',
          widths: '800, 1200, 1600, 2000, 2400'
      }}
    </div>
  {%- endif -%}

  {%- comment -%} Overlay {%- endcomment -%}
  <div
    class="final-cta__overlay"
    style="background-color: {{ section.settings.overlay_color }}; opacity: {{ overlay_opacity }};"
    aria-hidden="true"
  ></div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="final-cta__inner page-width">

    {%- if section.settings.eyebrow != blank -%}
      <p class="final-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="final-cta__heading" id="final-cta-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="final-cta__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="final-cta__buttons">
      {%- if section.settings.btn_primary_label != blank -%}
        <a
          href="{{ section.settings.btn_primary_url | default: '/collections/all' }}"
          class="final-cta__btn final-cta__btn--primary"
        >
          {{- section.settings.btn_primary_label | escape -}}
        </a>
      {%- endif -%}

      {%- if section.settings.btn_secondary_label != blank -%}
        <a
          href="{{ section.settings.btn_secondary_url | default: '/products/mattheusse-discovery-set' }}"
          class="final-cta__btn final-cta__btn--secondary"
        >
          {{- section.settings.btn_secondary_label | escape -}}
        </a>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  #custom-final-cta-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.min_height }}px;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
    text-align: center;
  }

  /* Background image */
  #custom-final-cta-{{ section.id }} .final-cta__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #custom-final-cta-{{ section.id }} .final-cta__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Overlay */
  #custom-final-cta-{{ section.id }} .final-cta__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Content */
  #custom-final-cta-{{ section.id }} .final-cta__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 720px;
  }

  #custom-final-cta-{{ section.id }} .final-cta__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  #custom-final-cta-{{ section.id }} .final-cta__heading {
    font-size: clamp(2.5rem, 5.6vw, 3.5rem);
    line-height: 1.1;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  #custom-final-cta-{{ section.id }} .final-cta__subheading {
    font-size: 1rem;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    margin: 0;
    max-width: 540px;
  }

  /* Buttons */
  #custom-final-cta-{{ section.id }} .final-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  #custom-final-cta-{{ section.id }} .final-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 5px;
    border: 2px solid transparent;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
    min-width: 160px;
  }

  /* Primary — filled */
  #custom-final-cta-{{ section.id }} .final-cta__btn--primary {
    background-color: {{ section.settings.btn_primary_bg }};
    color: {{ section.settings.btn_primary_text }};
    border-color: {{ section.settings.btn_primary_bg }};
  }

  #custom-final-cta-{{ section.id }} .final-cta__btn--primary:hover {
    background-color: transparent;
    color: {{ section.settings.btn_primary_bg }};
  }

  /* Secondary — outline */
  #custom-final-cta-{{ section.id }} .final-cta__btn--secondary {
    background-color: transparent;
    color: {{ section.settings.text_color }};
    border-color: {{ section.settings.text_color }};
  }

  #custom-final-cta-{{ section.id }} .final-cta__btn--secondary:hover {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
  }

  /* Mobile */
  @media (max-width: 749px) {
    #custom-final-cta-{{ section.id }} {
      min-height: {{ section.settings.min_height | times: 0.7 | round }}px;
    }

    #custom-final-cta-{{ section.id }} .final-cta__heading {
      font-size: 2rem;
    }

    #custom-final-cta-{{ section.id }} .final-cta__buttons {
      flex-direction: column;
      width: 100%;
    }

    #custom-final-cta-{{ section.id }} .final-cta__btn {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Final CTA Banner",
  "tag": "section",
  "class": "section-final-cta",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color (fallback)",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Ready?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND YOUR SIGNATURE SCENT"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wear something worth remembering. Free shipping on orders ₱1,200 and above."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary button label",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Primary button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_primary_text",
      "label": "Primary button text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary button label",
      "default": "TRY DISCOVERY SET"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary button URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Final CTA Banner"
    }
  ]
}
{% endschema %}
