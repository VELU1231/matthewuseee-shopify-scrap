{% comment %}
  ┌─────────────────────────────────────────────────────────────┐
  │  sections/custom-hero.liquid                                │
  │  Full-bleed hero section with:                             │
  │    • Background image + optional dark overlay               │
  │    • Star-rating row (image or SVG repeat)                  │
  │    • H1 headline + H5 subtitle                              │
  │    • Up to 3 feature pill badges (checkmark + text)         │
  │    • Two CTA buttons (primary + secondary outline)          │
  │                                                             │
  │  Replicates the Mattheuse hero section:                     │
  │  "MINIMAL. MASCULINE. MAGNETIC."                            │
  │                                                             │
  │  Docs:                                                      │
  │  • image_url filter  → shopify.dev/docs/api/liquid/        │
  │      filters/image_url                                      │
  │  • image_tag filter  → shopify.dev/docs/api/liquid/        │
  │      filters/image_tag                                      │
  │  • section schema    → shopify.dev/docs/storefronts/themes/ │
  │      architecture/sections/section-schema                   │
  └─────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign text_align = section.settings.text_alignment
  assign min_height = section.settings.min_height
-%}

<style>
  /* ── Section shell ─────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ min_height }}px;
    overflow: hidden;
    color: {{ section.settings.text_color }};
  }

  /* ── Background image ──────────────────────────────────── */
  #shopify-section-{{ section.id }} .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* ── Dark overlay ──────────────────────────────────────── */
  #shopify-section-{{ section.id }} .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ overlay_opacity }};
  }

  /* ── Content wrapper ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 120rem;        /* --normal-page-width from Horizon */
    margin: 0 auto;
    padding: 80px 40px;
    text-align: {{ text_align }};
  }

  /* ── Star rating row ───────────────────────────────────── */
  #shopify-section-{{ section.id }} .hero__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 20px;
    justify-content: {% if text_align == 'center' %}center{% elsif text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  #shopify-section-{{ section.id }} .hero__stars svg {
    width: 18px;
    height: 18px;
    fill: #F5C518;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .hero__rating-label {
    font-size: 13px;
    letter-spacing: 0.04em;
    opacity: 0.85;
    margin-left: 8px;
    font-family: 'HelveticaNowDisplay-Medium', sans-serif;
  }

  /* ── Headline ──────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .hero__heading {
    font-family: 'HelveticaNowDisplay-ExtraBold', sans-serif;
    font-size: clamp(3.0rem, 5.6vw, 3.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
    color: {{ section.settings.text_color }};
  }

  /* ── Subtitle ──────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .hero__subtitle {
    font-family: 'HelveticaNowDisplay-Medium', sans-serif;
    font-size: 0.875rem;         /* --font-size--h5 */
    line-height: 1.6;
    opacity: 0.85;
    margin: 0 0 32px;
    max-width: 480px;
    {% if text_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
  }

  /* ── Feature pills ─────────────────────────────────────── */
  #shopify-section-{{ section.id }} .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
    justify-content: {% if text_align == 'center' %}center{% elsif text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  #shopify-section-{{ section.id }} .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 40px;           /* --style-border-radius-pills */
    font-family: 'HelveticaNowDisplay-Medium', sans-serif;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: inherit;
    backdrop-filter: blur(4px);
    background: rgba(255,255,255,0.08);
  }

  #shopify-section-{{ section.id }} .hero__pill svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    flex-shrink: 0;
  }

  /* ── CTA button row ────────────────────────────────────── */
  #shopify-section-{{ section.id }} .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: {% if text_align == 'center' %}center{% elsif text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  /* Primary button — black fill */
  #shopify-section-{{ section.id }} .hero__btn--primary {
    display: inline-block;
    padding: 12px 20px;
    background: {{ section.settings.btn_primary_bg }};
    color: {{ section.settings.btn_primary_text }};
    border: 2px solid {{ section.settings.btn_primary_bg }};
    border-radius: 5px;            /* --style-border-radius-buttons-primary */
    font-family: 'HelveticaNowDisplay-ExtraBold', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.25s ease-out, border-color 0.25s ease-out;
  }

  #shopify-section-{{ section.id }} .hero__btn--primary:hover {
    background: #a6a6a6;
    border-color: #a6a6a6;
  }

  /* Secondary button — transparent outline */
  #shopify-section-{{ section.id }} .hero__btn--secondary {
    display: inline-block;
    padding: 12px 20px;
    background: transparent;
    color: {{ section.settings.btn_secondary_text }};
    border: 2px solid {{ section.settings.btn_secondary_border }};
    border-radius: 5px;
    font-family: 'HelveticaNowDisplay-ExtraBold', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.25s ease-out, color 0.25s ease-out;
  }

  #shopify-section-{{ section.id }} .hero__btn--secondary:hover {
    background: rgba(255,255,255,0.15);
  }

  /* ── Mobile (≤ 749px) ──────────────────────────────────── */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      min-height: {{ min_height | times: 0.75 | round }}px;
    }

    #shopify-section-{{ section.id }} .hero__content {
      padding: 60px 16px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .hero__heading {
      font-size: 34px;
    }

    #shopify-section-{{ section.id }} .hero__stars,
    #shopify-section-{{ section.id }} .hero__pills,
    #shopify-section-{{ section.id }} .hero__ctas {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .hero__subtitle {
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .hero__ctas {
      flex-direction: column;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .hero__btn--primary,
    #shopify-section-{{ section.id }} .hero__btn--secondary {
      width: 100%;
      max-width: 320px;
      text-align: center;
    }
  }
</style>

{%- comment -%} Background image {%- endcomment -%}
{%- if section.settings.bg_image != blank -%}
  {%- assign hero_alt = section.settings.bg_image.alt | default: '' | escape -%}
  {{
    section.settings.bg_image
    | image_url: width: 2000
    | image_tag:
      class: 'hero__bg',
      loading: 'eager',
      fetchpriority: 'high',
      alt: hero_alt,
      widths: '750, 1100, 1500, 1800, 2000',
      sizes: '100vw'
  }}
{%- elsif section.settings.bg_color != blank -%}
  {%- comment -%} Fallback solid color if no image uploaded {%- endcomment -%}
  <style>
    #shopify-section-{{ section.id }} { background-color: {{ section.settings.bg_color }}; }
  </style>
{%- endif -%}

{%- comment -%} Overlay {%- endcomment -%}
{%- if overlay_opacity > 0 -%}
  <div class="hero__overlay" aria-hidden="true"></div>
{%- endif -%}

<div class="hero__content">

  {%- comment -%} Star rating row {%- endcomment -%}
  {%- if section.settings.show_stars -%}
    <div class="hero__stars" aria-label="{{ section.settings.stars_label | escape }}">
      {%- for i in (1..5) -%}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      {%- endfor -%}
      {%- if section.settings.stars_label != blank -%}
        <span class="hero__rating-label">{{ section.settings.stars_label | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} H1 headline {%- endcomment -%}
  {%- if section.settings.heading != blank -%}
    <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}

  {%- comment -%} Subtitle {%- endcomment -%}
  {%- if section.settings.subtitle != blank -%}
    <p class="hero__subtitle">{{ section.settings.subtitle | escape }}</p>
  {%- endif -%}

  {%- comment -%}
    Feature pills — rendered from blocks.
    Blocks of type "pill" each have a text setting.
    block.shopify_attributes is required for theme editor
    drag-to-reorder support.
    Ref: shopify.dev/docs/api/liquid/objects/block
  {%- endcomment -%}
  {%- assign pill_blocks = section.blocks | where: "type", "pill" -%}
  {%- if pill_blocks.size > 0 -%}
    <div class="hero__pills">
      {%- for block in pill_blocks -%}
        <span class="hero__pill" {{ block.shopify_attributes }}>
          {%- comment -%} Checkmark icon {%- endcomment -%}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {{ block.settings.text | escape }}
        </span>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} CTA buttons {%- endcomment -%}
  <div class="hero__ctas">
    {%- if section.settings.btn_primary_label != blank -%}
      <a
        href="{{ section.settings.btn_primary_url }}"
        class="hero__btn--primary"
      >
        {{ section.settings.btn_primary_label | escape }}
      </a>
    {%- endif -%}

    {%- if section.settings.btn_secondary_label != blank -%}
      <a
        href="{{ section.settings.btn_secondary_url }}"
        class="hero__btn--secondary"
      >
        {{ section.settings.btn_secondary_label | escape }}
      </a>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "Custom Hero",
  "tag": "section",
  "class": "custom-hero",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback background color",
      "default": "#000000",
      "info": "Used when no background image is set"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (px)",
      "min": 300,
      "max": 900,
      "step": 50,
      "default": 700
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Star rating"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star rating row",
      "default": true
    },
    {
      "type": "text",
      "id": "stars_label",
      "label": "Rating label text",
      "default": "Rated 5/5 by Thousands of Customers"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H1)",
      "default": "MINIMAL. MASCULINE. MAGNETIC."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (H5)",
      "default": "Crafted for those who move with quiet confidence."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_primary_text",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Button label",
      "default": "TRY DISCOVERY SET"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "btn_secondary_text",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_secondary_border",
      "label": "Button border color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "name": "Feature Pill",
      "type": "pill",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Pill text",
          "default": "All-day confidence"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero",
      "category": "Hero",
      "settings": {
        "heading": "MINIMAL. MASCULINE. MAGNETIC.",
        "subtitle": "Crafted for those who move with quiet confidence.",
        "stars_label": "Rated 5/5 by Thousands of Customers",
        "btn_primary_label": "SHOP NOW",
        "btn_secondary_label": "TRY DISCOVERY SET"
      },
      "blocks": [
        { "type": "pill", "settings": { "text": "Fresh, clean scent" } },
        { "type": "pill", "settings": { "text": "All-day confidence" } },
        { "type": "pill", "settings": { "text": "Day-to-night versatile" } }
      ]
    }
  ]
}
{% endschema %}
