{% comment %}
  ┌─────────────────────────────────────────────────────────────┐
  │  sections/custom-why-us.liquid                              │
  │  "WHY MATTHEUSSE?"                                          │
  │                                                             │
  │  4-column value proposition grid with:                      │
  │  - H2 section heading                                       │
  │  - Blocks: icon (inline SVG selector), heading, body text   │
  │  - Responsive: 2-col tablet, 1-col mobile                   │
  │                                                             │
  │  Value props from store:                                     │
  │  1. Extrait de Parfum — 35% fragrance concentration         │
  │  2. Premium, no markup                                      │
  │  3. Minimalist packaging                                    │
  │  4. Designed for Filipino men                               │
  │                                                             │
  │  Docs:                                                      │
  │  shopify.dev/docs/storefronts/themes/architecture/sections  │
  └─────────────────────────────────────────────────────────────┘
{% endcomment %}

{%- liquid
  assign prop_blocks = section.blocks | where: 'type', 'value_prop'
-%}

<section
  id="custom-why-us-{{ section.id }}"
  class="why-us"
  aria-labelledby="why-us-heading-{{ section.id }}"
>
  <div class="why-us__inner page-width">

    {%- if section.settings.eyebrow != blank -%}
      <p class="why-us__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="why-us__heading" id="why-us-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="why-us__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if prop_blocks.size > 0 -%}
      <ul class="why-us__grid" role="list">
        {%- for block in prop_blocks -%}
          <li class="why-us__item" {{ block.shopify_attributes }}>

            <div class="why-us__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'flask' -%}
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 6v14l-6 12a2 2 0 001.8 2.9h20.4A2 2 0 0032 32L26 20V6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M13 6h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M12 28h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="2 3"/>
                  </svg>

                {%- when 'tag' -%}
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 5H8a2 2 0 00-2 2v13l14 14 13-13L21 5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <circle cx="12" cy="12" r="2" fill="currentColor"/>
                  </svg>

                {%- when 'box' -%}
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="5" y="12" width="30" height="24" rx="2" stroke="currentColor" stroke-width="2"/>
                    <path d="M5 18h30" stroke="currentColor" stroke-width="2"/>
                    <path d="M15 12V6h10v6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M16 24h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>

                {%- when 'flag' -%}
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 6v28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M8 8h20l-4 8 4 8H8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  </svg>

                {%- when 'star' -%}
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 5l4.6 9.3 10.3 1.5-7.4 7.2 1.7 10.2L20 28.7l-9.2 4.5 1.7-10.2-7.4-7.2 10.3-1.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  </svg>

                {%- when 'leaf' -%}
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 32c2-8 6-16 24-24C26 14 18 22 8 32z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M8 32c4-6 10-10 16-12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="2 3"/>
                  </svg>

                {%- else -%}
                  {%- comment -%} Default: checkmark circle {%- endcomment -%}
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="15" stroke="currentColor" stroke-width="2"/>
                    <path d="M13 20l5 5 9-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              {%- endcase -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <h3 class="why-us__item-heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="why-us__item-text">{{ block.settings.text }}</p>
            {%- endif -%}

          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</section>

<style>
  #custom-why-us-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    text-align: {{ section.settings.text_alignment }};
  }

  #custom-why-us-{{ section.id }} .why-us__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 0.75rem;
  }

  #custom-why-us-{{ section.id }} .why-us__heading {
    font-size: clamp(2.25rem, 4.8vw, 3rem);
    line-height: 1.1;
    margin-bottom: 0.75rem;
    color: {{ section.settings.text_color }};
  }

  #custom-why-us-{{ section.id }} .why-us__subheading {
    font-size: 1rem;
    opacity: 0.75;
    margin-bottom: 3rem;
    max-width: 520px;
    {% if section.settings.text_alignment == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
  }

  /* Grid */
  #custom-why-us-{{ section.id }} .why-us__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Card */
  #custom-why-us-{{ section.id }} .why-us__item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: {% if section.settings.text_alignment == 'center' %}center{% else %}flex-start{% endif %};
  }

  /* Icon */
  #custom-why-us-{{ section.id }} .why-us__icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: {{ section.settings.icon_bg }};
    color: {{ section.settings.icon_color }};
    flex-shrink: 0;
  }

  #custom-why-us-{{ section.id }} .why-us__icon svg {
    width: 28px;
    height: 28px;
  }

  /* Text */
  #custom-why-us-{{ section.id }} .why-us__item-heading {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  #custom-why-us-{{ section.id }} .why-us__item-text {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.75;
    margin: 0;
  }

  /* Tablet: 2 columns */
  @media (max-width: 989px) {
    #custom-why-us-{{ section.id }} .why-us__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile: 1 column */
  @media (max-width: 749px) {
    #custom-why-us-{{ section.id }} .why-us__heading {
      font-size: 1.75rem;
    }

    #custom-why-us-{{ section.id }} .why-us__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Why Us",
  "tag": "section",
  "class": "section-why-us",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Difference"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHY MATTHEUSSE?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Luxury without compromise. Crafted for the Filipino man."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "value_prop",
      "name": "Value Proposition",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "flask", "label": "Flask (concentration)" },
            { "value": "tag", "label": "Tag (pricing)" },
            { "value": "box", "label": "Box (packaging)" },
            { "value": "flag", "label": "Flag (origin)" },
            { "value": "star", "label": "Star (quality)" },
            { "value": "leaf", "label": "Leaf (natural)" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Every bottle is crafted with the highest standards."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Us",
      "blocks": [
        {
          "type": "value_prop",
          "settings": {
            "icon": "flask",
            "heading": "Extrait de Parfum 35%",
            "text": "The highest fragrance concentration available — not Eau de Toilette. One spray lasts all day."
          }
        },
        {
          "type": "value_prop",
          "settings": {
            "icon": "tag",
            "heading": "Premium, No Markup",
            "text": "Luxury-grade ingredients priced fairly. No middlemen, no inflated margins."
          }
        },
        {
          "type": "value_prop",
          "settings": {
            "icon": "box",
            "heading": "Minimalist Packaging",
            "text": "Clean. Intentional. Every detail of the bottle and box reflects quiet confidence."
          }
        },
        {
          "type": "value_prop",
          "settings": {
            "icon": "flag",
            "heading": "Designed for Filipino Men",
            "text": "Formulated for tropical heat, humidity, and the Filipino way of life."
          }
        }
      ]
    }
  ]
}
{% endschema %}
